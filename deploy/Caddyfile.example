# Optional TLS reverse proxy for the web UI (Caddy).
# Install caddy, copy to /etc/caddy/Caddyfile, adjust the domain.
#
# NOTE: Meteor/SockJS needs unbuffered websocket forwarding — Caddy's
# default response buffering breaks the sockjs upgrade.
treegent.example.com {
    @sockjs path /sockjs/*
    handle @sockjs {
        reverse_proxy 127.0.0.1:3000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
