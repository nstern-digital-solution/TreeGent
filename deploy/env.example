# TreeGent central-host environment — copy to .env, fill in.
# Never commit real values. NOTE: NO inline comments after values —
# systemd EnvironmentFile and pydantic treat them as part of the value.

# ---------- shared ----------
# Mongo (user-provided; replica set required for Meteor reactivity).
# Atlas Flex works out of the box: paste the SRV string, e.g.
#   TG_MONGO_URL=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true
TG_MONGO_URL=mongodb://127.0.0.1:27017/?directConnection=true
# Central-tier token: web server -> services. NEVER put this on an agent host.
TG_SERVICE_TOKEN=change-me-random
# Fernet master key for secret VALUES (generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TG_SECRETS_MASTER_KEY=

# ---------- proxy (inference) ----------
# Providers (multiple, any keys/URLs) are added in the web UI Models tab;
# keys are stored encrypted. Keyfile for that encryption:
TG_PROXY_KEYFILE=/etc/treegent/keys.key

# ---------- files (S3, user-provided host) ----------
TG_FILES_S3_ENDPOINT=
TG_FILES_S3_BUCKET=
TG_FILES_S3_ACCESS_KEY=
TG_FILES_S3_SECRET_KEY=

# ---------- mail ----------
# Adapter rows live in Mongo (sink until a key lands):
RESEND_API_KEY=

# ---------- runtime ----------
# central host: ALWAYS false (R48)
TG_RUNTIME_EXEC_ENABLED=false
# heartbeat seconds, default 60 min (R44)
TG_RUNTIME_HEARTBEAT_S=3600
# agent hosts: dedicated unix user (R46)
TG_RUNTIME_EXEC_USER=

# ---------- web ----------
# (web uses TG_MONGO_URL — the same Mongo as the services)
TG_MAIL_DOMAIN=
